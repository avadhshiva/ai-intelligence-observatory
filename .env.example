# ==========================================
# AI Intelligence Observatory Configuration
# ==========================================

# OpenAI (required for CrewAI agent reasoning)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
USE_LLM=true

# News API
# Get key from https://newsapi.org
NEWSAPI_KEY=your-newsapi-key

# ==========================================
# Database
# ==========================================

# SQLite (default local database)
# DATABASE_URL=sqlite:///./data/observatory.db

# ==========================================
# Email Configuration
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

EMAIL_FROM=your.email@gmail.com
EMAIL_RECIPIENTS=your.email@gmail.com

# ==========================================
# Scheduler
# ==========================================

# Example: 07:00 IST
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Kolkata

# ==========================================
# News Collection
# ==========================================

NEWSAPI_QUERY=artificial intelligence OR OpenAI OR Anthropic OR DeepMind OR NVIDIA AI

MAX_RAW_STORIES=50
TOP_STORY_COUNT=10

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO